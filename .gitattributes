# Finales de linea deterministas. Sin esto, el mismo commit produce archivos
# distintos en Windows y en el CI de Linux, y dos cosas se rompen:
#   1. el sha256 del CSV crudo que verifica tests/test_pipeline.py
#   2. la comparacion entre el dashboard construido y el versionado

# El CSV crudo viene con CRLF desde IBM. Se trata como binario para que git no
# lo toque jamas: su sha256 esta fijado en src/paths.py y debe coincidir byte a
# byte en cualquier sistema operativo.
data/raw/*.csv -text

# Todo lo demas se normaliza a LF, que es lo que escribe src/build_dashboard.py.
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.ipynb text eol=lf

# Binarios: sin conversion ni diff de texto.
*.png   binary
*.pbix  binary

# --- Estadisticas de lenguaje (GitHub Linguist) ---

# El dashboard NO esta escrito a mano: lo genera src/build_dashboard.py a partir
# de assets/dashboard_template.html y los datos. Marcarlo como generado lo saca
# de las estadisticas de lenguaje y lo colapsa en los diffs. Sin esto, 156 KB de
# HTML generado tapan el codigo Python y el repo parece un proyecto web.
dashboards/rrhh_dashboard.html linguist-generated=true

# Las consultas SQL son parte central del analisis, no un anexo: que cuenten.
*.sql linguist-detectable=true
sql/queries.sql linguist-language=SQL
